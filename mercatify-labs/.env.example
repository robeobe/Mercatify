# Copy to .env and fill in — .env is gitignored, never commit real values.

# Only needed for the Catalog Curator agent (src/catalogCurator.ts), which is
# the only part of this package that makes a network call. The 5 core agents
# and the deterministic engine never need this.
#
# Free Firecrawl access was provided for HackOn 2026's AI Company track.
# Reusing this outside that track? Get your own key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Used by examples/run-voltix.ts (an OpenAI-compatible endpoint — LM Studio,
# Ollama, OpenAI itself, ...).
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen/qwen3-vl-30b
# LLM_API_KEY=lm-studio
