{
  "name": "mercatify-labs",
  "version": "0.1.0",
  "private": true,
  "description": "Mercatify Labs — deterministic core (catalog lookup + ROI engine) and portable agent specs for an AI consolidation company. Extracted from the Mercatify hackathon project — framework-agnostic, no Open Mercato dependency.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "renderer:generate": "node scripts/generate-browser-renderer.mjs",
    "browser:generate": "npm run catalog:generate && npm run renderer:generate",
    "browser:check": "node scripts/generate-browser-catalog.mjs --check && node scripts/generate-browser-renderer.mjs --check",
    "catalog:generate": "node scripts/generate-browser-catalog.mjs",
    "report": "ts-node bin/report-cli.ts",
    "example:voltix": "ts-node examples/run-voltix.ts",
    "example:curate": "ts-node examples/curate-catalog.ts",
    "example:report-prose": "ts-node examples/run-report-prose.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
