{
  "name": "map_capabilities",
  "kind": "pure",
  "backedBy": "src/mapCapabilities.ts#mapCapabilities",
  "description": "Pure catalog lookup (no reasoning): for every capability of every given SaaS product, returns the target platform feature, decision (native/configure/build/integrate/keep), confidence (high/medium/low) and evidence. Off-catalog capabilities come back as decision \"build\", confidence \"low\". This is the ONLY source of mapping decisions — the calling agent must never state a decision itself.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "products": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "category": { "type": "string" },
            "monthlyCost": { "type": "number" },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "capability": { "type": "string", "minLength": 1 },
                  "importance": { "type": "string", "enum": ["core", "nice"] },
                  "usageDescription": { "type": "string" }
                },
                "required": ["capability"]
              }
            }
          },
          "required": ["name", "capabilities"]
        }
      }
    },
    "required": ["products"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "mappings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "capability": { "type": "string" },
            "source": { "type": "string" },
            "targetFeature": { "type": "string" },
            "decision": { "type": "string", "enum": ["native", "configure", "build", "integrate", "keep"] },
            "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
            "evidence": { "type": "string" }
          },
          "required": ["capability", "source", "targetFeature", "decision", "confidence", "evidence"]
        }
      }
    },
    "required": ["mappings"]
  }
}
