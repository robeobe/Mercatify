{
  "name": "get_case_data",
  "kind": "host",
  "backedBy": null,
  "description": "Fetch a consolidation case: its company's SaaS stack, the capabilities recorded for each product, and any mappings already computed for the case. Returns { found: false } when the case does not exist or is out of scope.",
  "note": "The only tool NOT backed by a pure function in this package — it reads from the host application's own database. Implement it against whatever store holds CompanyProfile/SaaSProduct/SaaSCapability/Mapping records (see SPEC.md §4). Must enforce the host's own tenant/scope isolation; never trust a caller-supplied tenant id.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "caseId": { "type": "string", "description": "Consolidation case id." }
    },
    "required": ["caseId"],
    "additionalProperties": false
  },
  "outputSchema": {
    "oneOf": [
      {
        "type": "object",
        "properties": { "found": { "const": false }, "caseId": { "type": "string" } },
        "required": ["found", "caseId"]
      },
      {
        "type": "object",
        "properties": {
          "found": { "const": true },
          "caseId": { "type": "string" },
          "companyId": { "type": "string" },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "category": { "type": "string" },
                "monthlyCost": { "type": "number" },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "capability": { "type": "string" },
                      "importance": { "type": "string", "enum": ["core", "nice"] },
                      "usageDescription": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "capability": { "type": "string" },
                "source": { "type": "string" },
                "targetFeature": { "type": "string" },
                "decision": { "type": "string", "enum": ["native", "configure", "build", "integrate", "keep"] },
                "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
                "evidence": { "type": "string" }
              }
            }
          }
        },
        "required": ["found", "caseId", "companyId", "products", "mappings"]
      }
    ]
  }
}
